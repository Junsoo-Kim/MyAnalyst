# docker-compose.yml이 읽는 환경 변수. 복사해서 .env로 저장한 뒤 값을 채우세요.
#   cp .env.example .env
# .env는 .gitignore에 등록되어 있어야 합니다 (커밋 금지).

# --- 필수: RAG 서버(FastAPI)가 사용하는 OpenAI API 키 ---
OPENAI_API_KEY=sk-...

# --- 선택: 기본값 사용 시 생략 가능 ---
# LLM_MODEL=gpt-4o-mini
# POSTGRES_PASSWORD=root
# CORS_ALLOWED_ORIGINS=http://localhost:3000
